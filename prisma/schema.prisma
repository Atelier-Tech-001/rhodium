generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(cuid())
  amount      String
  currency    String
  status      String
  createdAt   DateTime @default(now())
  merchantId  String
  merchantRef String?
}

model MerchantUser {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
